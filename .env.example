# Copy this file to .env and fill in your values.
# On Dokploy, add the same lines in the app's "Environment" tab.

# Database (PostgreSQL): one URL ...
DATABASE_URL=postgresql://postgres:your-password@your-host:5432/postgres
# ... or separate values (used when DATABASE_URL is empty)
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=your-host
# DB_PORT=5432

# Only needed on the server
SECRET_KEY=put-a-long-random-text-here
DEBUG=False
ALLOWED_HOSTS=minishop.example.com
CSRF_TRUSTED_ORIGINS=https://minishop.example.com
